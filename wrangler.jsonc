{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skwodnjs-english",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skwodnjs-english",
      "database_id": "359b3f91-73f7-4567-b938-48c01e215bd4"
    }
  ]
}
